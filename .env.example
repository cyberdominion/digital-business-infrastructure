# ---------------------------------------------------------------------------
# Digital Business Infrastructure Platform — environment template
# Copy to `.env.local` (git-ignored) and fill in real values.
# Anything prefixed with PUBLIC_ / NEXT_PUBLIC_ is sent to the browser.
# Server secrets must NEVER use a NEXT_PUBLIC_ prefix. See docs/architecture.md
# ---------------------------------------------------------------------------

# --- Supabase (PRD 44, 45) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Grants full access and BYPASSES row level security.
# Never expose this to any client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI (PRD 47) -----------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# --- Payments — Paystack (PRD 52, 22) -------------------------------------
# Test keys while developing; live keys only in production secrets.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used for HMAC SHA512 webhook verification. From Paystack dashboard.
PAYSTACK_WEBHOOK_SECRET=

# --- Email — Resend (PRD 51) ----------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Atlas Digital Business <notifications@your-domain.example>

# --- Media — Cloudinary (PRD 50) ------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Automation — n8n (PRD 49) --------------------------------------------
N8N_BASE_URL=https://n8n.example.com
N8N_API_KEY=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set true only for local Supabase so SSR cookies are allowed on http.
NEXT_PUBLIC_VERIFY_SUPABASE_SSR=false